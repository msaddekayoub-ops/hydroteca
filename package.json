{
  "name": "hydroteca",
  "version": "1.0.0",
  "description": "HYDROTECA - Travaux Divers et Prestation des Services",
  "main": "main.js",
  "productName": "HYDROTECA",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.hydroteca.gestionchantiers",
    "productName": "HYDROTECA",
    "files": [
      "index.html",
      "main.js",
      "icon.ico",
      "logo.png",
      "iconnn.ico",
      "node_modules/electron-squirrel-startup/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HYDROTECA"
    },
    "mac": {
      "target": [{ "target": "zip", "arch": ["x64", "arm64"] }],
      "icon": "icon.icns",
      "category": "public.app-category.business"
    }
  },
  "author": "Ayoub Msaddek",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
